# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2

properties:
  configurationVersion: 0.2.1
  resources:
  
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: vsPackage
      directives:
        description: Install Visual Studio Community
        securityContext: elevated
      settings:
        id: Microsoft.VisualStudio.Community
        source: winget
        useLatest: true

    - resource: Microsoft.VisualStudio.DSC/VSComponents
      id: vsComponents
      dependsOn:
        - vsPackage
      directives:
        description: Install Visual Studio workloads and components from .vsconfig
        securityContext: elevated
      settings:
        productId: Microsoft.VisualStudio.Product.Community
        channelId: VisualStudio.18.Release
        vsConfigFile: '${WinGetConfigRoot}\.vsconfig'
        includeRecommended: true

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: sdkPackage
      directives:
        securityContext: elevated
        description: Install Windows SDK version 28000
        allowPrerelease: true
      settings:
        id: Microsoft.WindowsSDK.10.0.28000
        source: winget
        useLatest: true

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: wdkPackage
      dependsOn:
        - sdkPackage
      directives:
        securityContext: elevated
        description: Install Windows Driver Kit version 28000
        allowPrerelease: true
      settings:
        id: Microsoft.WindowsWDK.10.0.28000
        source: winget
        useLatest: true

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgMsys2
      settings:
        id: MSYS2.MSYS2
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgIntelOneApi
      dependsOn:
        - vsComponents
      directives:
        description: Install Intel OneAPI Toolkit
        securityContext: elevated
      settings:
        id: Intel.OneAPI.Toolkit
        source: winget
        override: '-a --silent --eula accept -p=NEED_VS2022_INTEGRATION=1 -p=NEED_VS2026_INTEGRATION=1'

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgEIM
      settings:
        id: Espressif.EIM
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgArduino
      settings:
        id: ArduinoSA.IDE.stable
        source: winget
