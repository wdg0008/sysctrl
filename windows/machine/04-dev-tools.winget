# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2

properties:
  configurationVersion: 0.2.1
  resources:

    # Needs elevation for installation of container runtime and daemon
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgDockerDesktop
      directives:
        securityContext: elevated
      settings:
        id: Docker.DockerDesktop
        source: winget

    # Needs elevation for installation of container runtime and daemon
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgPodman
      directives:
        securityContext: elevated
      settings:
        id: RedHat.Podman
        source: winget

    # Needs elevation to install binaries to Program Files
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgOpenSSL
      directives:
        description: Install OpenSSL Light
        securityContext: elevated
      settings:
        id: ShiningLight.OpenSSL.LTS.Light
        source: winget
        override: '/VERYSILENT /SP- /NOCANCEL /NORESTART /TASKS="bin"'

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgCmake
      settings:
        id: Kitware.CMake
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgGit
      settings:
        id: Git.Git
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgOctave
      settings:
        id: GNU.Octave
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgPowerToys
      settings:
        id: Microsoft.PowerToys
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgRustup
      settings:
        id: Rustlang.Rustup
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgTemurin25
      settings:
        id: EclipseAdoptium.Temurin.25.JDK
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgVSCode
      settings:
        id: Microsoft.VisualStudioCode
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgVSLocator
      settings:
        id: Microsoft.VisualStudio.Locator
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgXmake
      settings:
        id: Xmake-io.Xmake
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgDoxygen
      settings:
        id: DimitriVanHeesch.Doxygen
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgPuTTY
      settings:
        id: PuTTY.PuTTY
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgMobaXTerm
      settings:
        id: Mobatek.MobaXterm
        source: winget