# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2

properties:
  configurationVersion: 0.2.1
  resources:

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgTIConnect
      settings:
        id: TexasInstruments.TIConnect
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgLocalSend
      settings:
        id: LocalSend.LocalSend
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgESword
      settings:
        id: RickMeyers.e-Sword
        source: winget

    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: pkgDiscord
      settings:
        id: Discord.Discord
        source: winget
